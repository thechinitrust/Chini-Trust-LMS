# Copy this file to .env.local and fill in real values when Supabase is wired in.
# Nothing in the app reads these yet — see docs/supabase-integration.md.

NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=
# Public, canonical site URL used in Supabase email redirects.
NEXT_PUBLIC_SITE_URL=https://learn.chinitrust.org

# Server-only — never expose to the client/browser.
SUPABASE_SERVICE_ROLE_KEY=

