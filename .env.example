# Copy this file to .env.local and fill in real values when Supabase is wired in.
# Nothing in the app reads these yet — see docs/supabase-integration.md.

NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=

# Server-only — never expose to the client/browser.
SUPABASE_SERVICE_ROLE_KEY=

# Dev-only "Login as Admin/User" buttons on /login. Never set to true in
# production -- remove the block in src/app/login/page.tsx to strip it
# entirely once no longer needed.
NEXT_PUBLIC_ENABLE_QUICK_LOGIN=false

# Optional, for the AI NeuroGuide backend once it's connected to a real model.
# AI_PROVIDER_API_KEY=
